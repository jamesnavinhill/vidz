{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vidz",
  "version": "0.1.0",
  "identifier": "com.vidz.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420/",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vidz",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "vidz",
    "shortDescription": "Local video viewer for large clip libraries",
    "longDescription": "vidz is a Windows-first local video viewer for browsing, sorting, and playing large clip libraries with fast scanning and thumbnail caching.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*"
    ]
  }
}
